-- Staff
CREATE TABLE StaffMemberEntity (
  id TEXT PRIMARY KEY NOT NULL,
  fullName TEXT NOT NULL,
  role TEXT NOT NULL,
  department TEXT,
  pin TEXT,
  active INTEGER NOT NULL DEFAULT 1,
  lastUpdated TEXT NOT NULL
);

-- Master patient
CREATE TABLE PatientEntity (
  id TEXT PRIMARY KEY NOT NULL,
  fullName TEXT NOT NULL,
  age INTEGER NOT NULL,
  sex TEXT NOT NULL,
  status TEXT NOT NULL,
  assignedWard TEXT,
  roomBed TEXT,
  acuity TEXT NOT NULL,
  isolation TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  syncedAt TEXT
);

CREATE TABLE ServiceEventEntity (
  service_event_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL,
  program TEXT NOT NULL,
  indicator_category TEXT NOT NULL,
  service_code TEXT,
  value_text TEXT,
  quantity INTEGER NOT NULL DEFAULT 1,
  event_datetime TEXT NOT NULL,
  sync_state TEXT NOT NULL DEFAULT 'LOCAL_ONLY'
);

-- Generic encounter core (OPD consultation / EMR)
CREATE TABLE EncounterEntity (
  encounter_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  patient_id TEXT NOT NULL,
  encounter_datetime TEXT NOT NULL,
  department TEXT NOT NULL,
  visit_type TEXT NOT NULL,
  provider_id TEXT,
  facility_id TEXT NOT NULL,
  location_id TEXT,
  source_type TEXT,
  source_id TEXT,
  status TEXT NOT NULL DEFAULT 'DRAFT',
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  nursing_notes TEXT,
  sync_state TEXT NOT NULL DEFAULT 'LOCAL_ONLY',
  FOREIGN KEY (patient_id) REFERENCES PatientEntity(id) ON DELETE CASCADE
);

CREATE INDEX idx_encounter_patient ON EncounterEntity(patient_id);
CREATE INDEX idx_encounter_provider ON EncounterEntity(provider_id);
CREATE INDEX idx_encounter_status ON EncounterEntity(status);
CREATE INDEX idx_encounter_server_id ON EncounterEntity(server_id);

CREATE TABLE EncounterHistoryEntity (
  encounter_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  chief_complaint TEXT NOT NULL DEFAULT '',
  hpi TEXT NOT NULL DEFAULT '',
  pmh TEXT NOT NULL DEFAULT '',
  medication_history TEXT NOT NULL DEFAULT '',
  allergies TEXT NOT NULL DEFAULT '',
  family_history TEXT NOT NULL DEFAULT '',
  social_history TEXT NOT NULL DEFAULT '',
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);

CREATE TABLE EncounterExamEntity (
  encounter_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  system_exam_notes TEXT NOT NULL DEFAULT '',
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);

CREATE TABLE EncounterPlanEntity (
  encounter_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  clinical_advice TEXT NOT NULL DEFAULT '',
  follow_up_date TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);

CREATE TABLE ClinicalOrderEntity (
  order_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  encounter_id TEXT NOT NULL,
  order_type TEXT NOT NULL,
  order_name TEXT NOT NULL,
  instructions TEXT,
  status TEXT NOT NULL DEFAULT 'ORDERED',
  sync_state TEXT NOT NULL DEFAULT 'LOCAL_ONLY',
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);

CREATE INDEX idx_clinical_order_encounter ON ClinicalOrderEntity(encounter_id);
CREATE INDEX idx_clinical_order_type ON ClinicalOrderEntity(order_type);
CREATE INDEX idx_clinical_order_server_id ON ClinicalOrderEntity(server_id);

CREATE TABLE VitalSignsEntity (
  vital_signs_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL,
  weight_kg REAL,
  height_cm REAL,
  bmi REAL,
  temperature_c REAL,
  systolic_bp INTEGER,
  diastolic_bp INTEGER,
  pulse_bpm INTEGER,
  respiratory_rate INTEGER,
  spo2_percent REAL,
  muac_cm REAL,
  recorded_at TEXT NOT NULL
);

CREATE TABLE PatientDocumentEntity (
  document_id TEXT PRIMARY KEY NOT NULL,
  patient_id TEXT NOT NULL,
  document_type TEXT NOT NULL,
  image_uri TEXT NOT NULL,
  verification_status TEXT NOT NULL,
  extracted_full_name TEXT,
  extracted_identifier TEXT,
  extracted_birth_date TEXT,
  extracted_sex TEXT,
  extracted_guardian_name TEXT,
  notes TEXT,
  captured_at TEXT NOT NULL
);

CREATE TABLE DiagnosisEntity (
  diagnosis_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  encounter_id TEXT NOT NULL,
  diagnosis_text TEXT NOT NULL,
  is_primary INTEGER NOT NULL DEFAULT 0,
  code_system TEXT,
  diagnosis_code TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);
CREATE INDEX idx_diagnosis_encounter ON DiagnosisEntity(encounter_id);
CREATE INDEX idx_diagnosis_server_id ON DiagnosisEntity(server_id);

CREATE TABLE MedicationOrderEntity (
  medication_order_id TEXT PRIMARY KEY NOT NULL,
  server_id TEXT,
  encounter_id TEXT NOT NULL,
  medication_name TEXT NOT NULL,
  dose TEXT,
  route TEXT,
  frequency TEXT,
  duration TEXT,
  instructions TEXT,
  version INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  deleted_at TEXT,
  FOREIGN KEY (encounter_id) REFERENCES EncounterEntity(encounter_id) ON DELETE CASCADE
);
CREATE INDEX idx_medication_order_encounter ON MedicationOrderEntity(encounter_id);
CREATE INDEX idx_medication_order_server_id ON MedicationOrderEntity(server_id);

CREATE TABLE EncounterOutcomeEntity (
  outcome_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  disposition TEXT NOT NULL,
  referral_to TEXT,
  admitted INTEGER NOT NULL DEFAULT 0,
  discharge_notes TEXT
);

-- Program extension tables
CREATE TABLE OpdVisitEntity (
  opd_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  age_months INTEGER,
  age_years INTEGER,
  residence TEXT NOT NULL,
  danger_signs INTEGER NOT NULL DEFAULT 0,
  muac_status TEXT,
  primary_diagnosis TEXT NOT NULL,
  treatment TEXT NOT NULL
);

CREATE TABLE AncVisitEntity (
  anc_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  parity INTEGER NOT NULL,
  gravida INTEGER NOT NULL,
  lmp_date TEXT NOT NULL,
  edd_date TEXT NOT NULL,
  visit_number INTEGER NOT NULL,
  gestational_age INTEGER,
  fundal_height INTEGER,
  urinalysis_protein TEXT,
  hiv_status TEXT,
  iptp_dose INTEGER,
  ifa_dispensed INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE MaternityDeliveryEntity (
  mat_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  admission_datetime TEXT NOT NULL,
  delivery_datetime TEXT,
  presentation TEXT,
  delivery_mode TEXT,
  blood_loss_ml INTEGER,
  infant_sex TEXT,
  birth_weight_g INTEGER,
  delivery_outcome TEXT,
  apgar_1min INTEGER,
  apgar_5min INTEGER,
  oxytocin_given INTEGER NOT NULL DEFAULT 0,
  discharge_maternal TEXT
);

CREATE TABLE CccVisitEntity (
  ccc_number TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  art_start_date TEXT NOT NULL,
  entry_point TEXT,
  baseline_who_stage TEXT,
  current_regimen TEXT,
  regimen_change_date TEXT,
  cohort_status TEXT,
  viral_load_value INTEGER,
  vl_collection_date TEXT,
  adherence_rating TEXT
);

CREATE TABLE NcdFollowupEntity (
  ncd_followup_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  ncd_id TEXT NOT NULL,
  systolic_bp INTEGER,
  diastolic_bp INTEGER,
  fbs_mmol REAL,
  rbs_mmol REAL,
  hba1c_percent REAL,
  weight_kg REAL,
  creatinine_value INTEGER,
  meds_dispensed TEXT,
  refill_qty_days INTEGER,
  complications TEXT
);

CREATE TABLE HtsRegisterEntity (
  hts_id TEXT PRIMARY KEY NOT NULL,
  encounter_id TEXT NOT NULL UNIQUE,
  serial_number TEXT,
  hts_number TEXT,
  population_type TEXT NOT NULL, -- General Pop, Key Pop, etc.
  testing_point TEXT NOT NULL, -- OPD, IPD, VCT, etc.
  test_1_result TEXT, -- Positive, Negative, Inconclusive
  test_2_result TEXT,
  final_result TEXT NOT NULL,
  couple_testing TEXT,
  recency_test_result TEXT,
  referred_to TEXT,
  linked_to_care INTEGER NOT NULL DEFAULT 0,
  remarks TEXT
);

-- Sync queue
CREATE TABLE SyncQueueEntity (
  id TEXT PRIMARY KEY NOT NULL,
  entityType TEXT NOT NULL,
  entityId TEXT NOT NULL,
  operation TEXT NOT NULL,
  payload TEXT NOT NULL,
  createdAt TEXT NOT NULL
);

selectAllStaff:
SELECT * FROM StaffMemberEntity;

insertStaff:
INSERT OR REPLACE INTO StaffMemberEntity(id, fullName, role, department, pin, active, lastUpdated)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteStaffById:
DELETE FROM StaffMemberEntity WHERE id = ?;

selectAllPatients:
SELECT * FROM PatientEntity ORDER BY fullName ASC;

selectPatientById:
SELECT * FROM PatientEntity WHERE id = ?;

upsertPatient:
INSERT OR REPLACE INTO PatientEntity(
  id, fullName, age, sex, status, assignedWard, roomBed, acuity, isolation, version, syncedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertEncounter:
INSERT OR REPLACE INTO EncounterEntity(
  encounter_id, server_id, patient_id, encounter_datetime, department, visit_type, provider_id, facility_id,
  location_id, source_type, source_id, status, version, created_at, updated_at, deleted_at, nursing_notes, sync_state
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertEncounterHistory:
INSERT OR REPLACE INTO EncounterHistoryEntity(
  encounter_id, server_id, chief_complaint, hpi, pmh, medication_history, allergies, family_history, social_history, version, created_at, updated_at, deleted_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectEncounterHistory:
SELECT * FROM EncounterHistoryEntity WHERE encounter_id = ?;

upsertEncounterExam:
INSERT OR REPLACE INTO EncounterExamEntity(
  encounter_id, server_id, system_exam_notes, version, created_at, updated_at, deleted_at
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectEncounterExam:
SELECT * FROM EncounterExamEntity WHERE encounter_id = ?;

upsertEncounterPlan:
INSERT OR REPLACE INTO EncounterPlanEntity(
  encounter_id, server_id, clinical_advice, follow_up_date, version, created_at, updated_at, deleted_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectEncounterPlan:
SELECT * FROM EncounterPlanEntity WHERE encounter_id = ?;

insertClinicalOrder:
INSERT OR REPLACE INTO ClinicalOrderEntity(order_id, server_id, encounter_id, order_type, order_name, instructions, status, sync_state, version, created_at, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectClinicalOrdersByEncounter:
SELECT * FROM ClinicalOrderEntity WHERE encounter_id = ? ORDER BY order_type, order_name;

deleteClinicalOrdersByEncounter:
DELETE FROM ClinicalOrderEntity WHERE encounter_id = ?;

deleteDiagnosisByEncounter:
DELETE FROM DiagnosisEntity WHERE encounter_id = ?;

deleteMedicationOrdersByEncounter:
DELETE FROM MedicationOrderEntity WHERE encounter_id = ?;

deleteVitalSignsByEncounter:
DELETE FROM VitalSignsEntity WHERE encounter_id = ?;

deleteEncounterHistory:
DELETE FROM EncounterHistoryEntity WHERE encounter_id = ?;

deleteEncounterExam:
DELETE FROM EncounterExamEntity WHERE encounter_id = ?;

deleteEncounterPlan:
DELETE FROM EncounterPlanEntity WHERE encounter_id = ?;

selectEncountersByPatient:
SELECT * FROM EncounterEntity WHERE patient_id = ? ORDER BY encounter_datetime DESC;

selectEncounterById:
SELECT * FROM EncounterEntity WHERE encounter_id = ?;

selectServiceEventById:
SELECT * FROM ServiceEventEntity WHERE service_event_id = ?;

selectVitalSignsById:
SELECT * FROM VitalSignsEntity WHERE vital_signs_id = ?;

selectPatientDocumentById:
SELECT * FROM PatientDocumentEntity WHERE document_id = ?;

selectHtsById:
SELECT * FROM HtsRegisterEntity WHERE hts_id = ?;

selectActiveVisitSummaries:
SELECT
  p.id AS patient_id,
  p.fullName AS full_name,
  p.age AS age,
  p.sex AS sex,
  e.encounter_id AS encounter_id,
  e.department AS department,
  e.visit_type AS visit_type,
  e.encounter_datetime AS encounter_datetime,
  e.sync_state AS sync_state
FROM EncounterEntity e
JOIN PatientEntity p ON p.id = e.patient_id
ORDER BY e.encounter_datetime DESC;

deleteEncounter:
DELETE FROM EncounterEntity WHERE encounter_id = ?;

deleteEncounterCascade:
DELETE FROM ClinicalOrderEntity WHERE encounter_id = ?;
DELETE FROM EncounterPlanEntity WHERE encounter_id = ?;
DELETE FROM EncounterExamEntity WHERE encounter_id = ?;
DELETE FROM EncounterHistoryEntity WHERE encounter_id = ?;
DELETE FROM DiagnosisEntity WHERE encounter_id = ?;
DELETE FROM MedicationOrderEntity WHERE encounter_id = ?;
DELETE FROM VitalSignsEntity WHERE encounter_id = ?;
DELETE FROM EncounterOutcomeEntity WHERE encounter_id = ?;
DELETE FROM ServiceEventEntity WHERE encounter_id = ?;
DELETE FROM EncounterEntity WHERE encounter_id = ?;

insertServiceEvent:
INSERT OR REPLACE INTO ServiceEventEntity(
  service_event_id, encounter_id, program, indicator_category, service_code,
  value_text, quantity, event_datetime, sync_state
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectServiceEventsByEncounter:
SELECT * FROM ServiceEventEntity WHERE encounter_id = ? ORDER BY event_datetime DESC;

getServiceIndicatorSummary:
SELECT
  program,
  indicator_category,
  COUNT(*) AS count,
  SUM(quantity) AS quantity
FROM ServiceEventEntity
WHERE event_datetime BETWEEN ? AND ?
GROUP BY program, indicator_category
ORDER BY program, indicator_category;

insertVitalSigns:
INSERT OR REPLACE INTO VitalSignsEntity(vital_signs_id, encounter_id, weight_kg, height_cm, bmi, temperature_c, systolic_bp, diastolic_bp, pulse_bpm, respiratory_rate, spo2_percent, muac_cm, recorded_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectVitalSignsByEncounter:
SELECT * FROM VitalSignsEntity WHERE encounter_id = ?;

insertPatientDocument:
INSERT OR REPLACE INTO PatientDocumentEntity(
  document_id, patient_id, document_type, image_uri, verification_status,
  extracted_full_name, extracted_identifier, extracted_birth_date, extracted_sex,
  extracted_guardian_name, notes, captured_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectDocumentsByPatient:
SELECT * FROM PatientDocumentEntity WHERE patient_id = ? ORDER BY captured_at DESC;

insertDiagnosis:
INSERT OR REPLACE INTO DiagnosisEntity(diagnosis_id, server_id, encounter_id, diagnosis_text, is_primary, code_system, diagnosis_code, version, created_at, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectDiagnosisByEncounter:
SELECT * FROM DiagnosisEntity WHERE encounter_id = ?;

insertMedicationOrder:
INSERT OR REPLACE INTO MedicationOrderEntity(medication_order_id, server_id, encounter_id, medication_name, dose, route, frequency, duration, instructions, version, created_at, updated_at, deleted_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMedicationOrdersByEncounter:
SELECT * FROM MedicationOrderEntity WHERE encounter_id = ?;

upsertEncounterOutcome:
INSERT OR REPLACE INTO EncounterOutcomeEntity(outcome_id, encounter_id, disposition, referral_to, admitted, discharge_notes)
VALUES (?, ?, ?, ?, ?, ?);

selectEncounterOutcome:
SELECT * FROM EncounterOutcomeEntity WHERE encounter_id = ?;

selectPendingSync:
SELECT * FROM SyncQueueEntity ORDER BY createdAt ASC;

insertSyncItem:
INSERT OR REPLACE INTO SyncQueueEntity(id, entityType, entityId, operation, payload, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteSyncItem:
DELETE FROM SyncQueueEntity WHERE id = ?;

-- HTS Register Queries
insertHtsEntry:
INSERT OR REPLACE INTO HtsRegisterEntity(
  hts_id, encounter_id, serial_number, hts_number, population_type,
  testing_point, test_1_result, test_2_result, final_result,
  couple_testing, recency_test_result, referred_to, linked_to_care, remarks
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHtsByEncounter:
SELECT * FROM HtsRegisterEntity WHERE encounter_id = ?;

-- MOH Report Aggregations (Example for HTS Lab)
getHtsSummary:
SELECT
    p.sex,
    p.age,
    h.final_result
FROM HtsRegisterEntity h
JOIN EncounterEntity e ON h.encounter_id = e.encounter_id
JOIN PatientEntity p ON e.patient_id = p.id
WHERE e.encounter_datetime BETWEEN ? AND ?;

-- Scheduling & Calendar Tables
CREATE TABLE ScheduleEntity (
  id TEXT PRIMARY KEY NOT NULL,
  actor_type TEXT NOT NULL,
  actor_id TEXT NOT NULL,
  name TEXT NOT NULL,
  active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE SlotEntity (
  id TEXT PRIMARY KEY NOT NULL,
  schedule_id TEXT NOT NULL,
  start_time TEXT NOT NULL,
  end_time TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'free'
);

CREATE TABLE AppointmentEntity (
  id TEXT PRIMARY KEY NOT NULL,
  patient_id TEXT NOT NULL,
  schedule_id TEXT NOT NULL,
  slot_id TEXT,
  status TEXT NOT NULL DEFAULT 'booked',
  appointment_type TEXT NOT NULL,
  reason TEXT,
  start_time TEXT NOT NULL,
  end_time TEXT NOT NULL,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

-- Scheduling Queries
selectAllSchedules:
SELECT * FROM ScheduleEntity;

insertSchedule:
INSERT OR REPLACE INTO ScheduleEntity(id, actor_type, actor_id, name, active)
VALUES (?, ?, ?, ?, ?);

selectSlotsBySchedule:
SELECT * FROM SlotEntity WHERE schedule_id = ? ORDER BY start_time ASC;

insertSlot:
INSERT OR REPLACE INTO SlotEntity(id, schedule_id, start_time, end_time, status)
VALUES (?, ?, ?, ?, ?);

updateSlotStatus:
UPDATE SlotEntity SET status = ? WHERE id = ?;

selectAppointmentsByPatient:
SELECT * FROM AppointmentEntity WHERE patient_id = ? ORDER BY start_time DESC;

selectAppointmentsBySchedule:
SELECT * FROM AppointmentEntity WHERE schedule_id = ? ORDER BY start_time ASC;

selectAppointmentById:
SELECT * FROM AppointmentEntity WHERE id = ?;

insertAppointment:
INSERT OR REPLACE INTO AppointmentEntity(id, patient_id, schedule_id, slot_id, status, appointment_type, reason, start_time, end_time, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAppointmentById:
DELETE FROM AppointmentEntity WHERE id = ?;

checkOverlappingAppointments:
SELECT COUNT(*) FROM AppointmentEntity 
WHERE schedule_id = ? AND status = 'booked' AND start_time < ? AND end_time > ?;

-- Lab / LIMS tables
CREATE TABLE LabTestEntity (
  id TEXT PRIMARY KEY NOT NULL,
  code TEXT NOT NULL,
  name TEXT NOT NULL,
  category TEXT NOT NULL,
  specimen_type TEXT NOT NULL,
  department TEXT NOT NULL,
  loinc_code TEXT,
  default_unit TEXT,
  default_reference_range TEXT,
  billing_code TEXT NOT NULL,
  price REAL NOT NULL,
  active INTEGER NOT NULL DEFAULT 1,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL
);

CREATE TABLE LabOrderEntity (
  id TEXT PRIMARY KEY NOT NULL,
  patient_id TEXT NOT NULL,
  encounter_id TEXT,
  ordered_by TEXT NOT NULL,
  department TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'ORDERED',
  priority TEXT NOT NULL DEFAULT 'ROUTINE',
  diagnosis_hint TEXT,
  clinical_notes TEXT,
  sample_id TEXT,
  billable_group_id TEXT,
  verified_by TEXT,
  verified_at TEXT,
  reported_by TEXT,
  reported_at TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(patient_id) REFERENCES PatientEntity(id)
);

CREATE TABLE LabOrderItemEntity (
  id TEXT PRIMARY KEY NOT NULL,
  order_id TEXT NOT NULL,
  test_id TEXT NOT NULL,
  test_code TEXT NOT NULL,
  test_name TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'ORDERED',
  priority TEXT NOT NULL DEFAULT 'ROUTINE',
  instructions TEXT,
  billing_code TEXT NOT NULL,
  price REAL NOT NULL DEFAULT 0,
  ordered_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(order_id) REFERENCES LabOrderEntity(id) ON DELETE CASCADE
);

CREATE TABLE LabSampleEntity (
  id TEXT PRIMARY KEY NOT NULL,
  order_id TEXT NOT NULL,
  patient_id TEXT NOT NULL,
  specimen_type TEXT NOT NULL,
  accession_number TEXT,
  collected_by TEXT,
  collected_at TEXT,
  received_by TEXT,
  received_at TEXT,
  rejected_reason TEXT,
  status TEXT NOT NULL DEFAULT 'ORDERED',
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(order_id) REFERENCES LabOrderEntity(id) ON DELETE CASCADE,
  FOREIGN KEY(patient_id) REFERENCES PatientEntity(id)
);

CREATE TABLE LabResultEntity (
  id TEXT PRIMARY KEY NOT NULL,
  order_id TEXT NOT NULL,
  order_item_id TEXT NOT NULL,
  patient_id TEXT NOT NULL,
  test_id TEXT NOT NULL,
  test_code TEXT NOT NULL,
  test_name TEXT NOT NULL,
  value TEXT NOT NULL,
  value_numeric REAL,
  unit TEXT,
  reference_range TEXT,
  flag TEXT,
  comment TEXT,
  entered_by TEXT NOT NULL,
  entered_at TEXT NOT NULL,
  verified_by TEXT,
  verified_at TEXT,
  reported_by TEXT,
  reported_at TEXT,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  FOREIGN KEY(order_id) REFERENCES LabOrderEntity(id) ON DELETE CASCADE,
  FOREIGN KEY(order_item_id) REFERENCES LabOrderItemEntity(id) ON DELETE CASCADE,
  FOREIGN KEY(patient_id) REFERENCES PatientEntity(id)
);

CREATE INDEX idx_lab_orders_patient ON LabOrderEntity(patient_id);
CREATE INDEX idx_lab_orders_status ON LabOrderEntity(status);
CREATE INDEX idx_lab_orders_department ON LabOrderEntity(department);
CREATE INDEX idx_lab_items_order ON LabOrderItemEntity(order_id);
CREATE INDEX idx_lab_results_order ON LabResultEntity(order_id);

insertLabOrder:
INSERT OR REPLACE INTO LabOrderEntity(
  id, patient_id, encounter_id, ordered_by, department, status, priority, diagnosis_hint, clinical_notes,
  sample_id, billable_group_id, verified_by, verified_at, reported_by, reported_at, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertLabOrderItem:
INSERT OR REPLACE INTO LabOrderItemEntity(
  id, order_id, test_id, test_code, test_name, status, priority, instructions, billing_code, price, ordered_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertLabSample:
INSERT OR REPLACE INTO LabSampleEntity(
  id, order_id, patient_id, specimen_type, accession_number, collected_by, collected_at, received_by, received_at,
  rejected_reason, status, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertLabResult:
INSERT OR REPLACE INTO LabResultEntity(
  id, order_id, order_item_id, patient_id, test_id, test_code, test_name, value, value_numeric, unit, reference_range,
  flag, comment, entered_by, entered_at, verified_by, verified_at, reported_by, reported_at, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectLabOrderById:
SELECT * FROM LabOrderEntity WHERE id = ?;

selectLabOrdersByPatient:
SELECT * FROM LabOrderEntity WHERE patient_id = ? ORDER BY created_at DESC;

selectLabWorklistByDepartment:
SELECT * FROM LabOrderEntity WHERE department = ? ORDER BY created_at DESC;

selectLabWorklistByDepartmentAndStatus:
SELECT * FROM LabOrderEntity WHERE department = ? AND status = ? ORDER BY created_at DESC;

selectLabOrderItemsByOrder:
SELECT * FROM LabOrderItemEntity WHERE order_id = ? ORDER BY test_name ASC;

selectLabResultsByOrder:
SELECT * FROM LabResultEntity WHERE order_id = ? ORDER BY created_at ASC;

updateLabOrderStatus:
UPDATE LabOrderEntity
SET status = ?, verified_by = ?, verified_at = ?, reported_by = ?, reported_at = ?, updated_at = ?
WHERE id = ?;
