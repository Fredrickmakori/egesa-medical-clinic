<!-- Web Server Configuration for Proper MIME Types -->
<!--
This file should be placed in the web server root directory.
It configures proper MIME types and headers for WASM and related files.
-->

<configuration>
    <system.webServer>
        <!-- MIME Types for WebAssembly and related files -->
        <staticContent>
            <!-- WebAssembly -->
            <mimeMap fileExtension=".wasm" mimeType="application/wasm" />

            <!-- JavaScript -->
            <mimeMap fileExtension=".js" mimeType="application/javascript" />
            <mimeMap fileExtension=".mjs" mimeType="application/javascript" />

            <!-- Other assets -->
            <mimeMap fileExtension=".html" mimeType="text/html" />
            <mimeMap fileExtension=".css" mimeType="text/css" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
        </staticContent>

        <!-- CORS Headers -->
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin" value="*" />
                <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
                <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />

                <!-- Caching for versioned assets -->
                <add name="Cache-Control" value="public, max-age=31536000" />
            </customHeaders>
        </httpProtocol>

        <!-- URL Rewrite for SPA routing -->
        <rewrite>
            <rules>
                <rule name="React SPA" stopProcessing="true">
                    <match url="^(?!.*\.(js|css|svg|png|jpg|jpeg|gif|ico|wasm|map)$).*$" />
                    <conditions logicalGrouping="MatchList" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="/index.html" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>

